# Ollama sunucusunun adresi
OLLAMA_URL=http://localhost:11434
# Sohbet + karar verme modeli (araç çağırmayı destekleyen bir model seçin)
SOHBET_MODELI=qwen2.5:7b
# Kod yazma modeli
KOD_MODELI=qwen2.5-coder:7b
# Hafıza için gömme (embedding) modeli
GOMME_MODELI=nomic-embed-text
# Kod çalıştırmadan önce onay iste (1 = evet, 0 = hayır)
KOD_ONAYI=1
# Kod çalıştırmayı Docker içinde yap (1 = evet). Docker kurulu olmalı.
DOCKER_SANDBOX=0
