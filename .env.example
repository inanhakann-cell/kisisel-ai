# Ollama sunucusunun adresi
OLLAMA_URL=http://localhost:11434
# Sohbet + karar verme modeli (araç çağırmayı destekleyen bir model seçin)
SOHBET_MODELI=qwen2.5:7b
# Kod yazma modeli
KOD_MODELI=qwen2.5-coder:7b
# Hafıza için gömme (embedding) modeli
GOMME_MODELI=nomic-embed-text
# Kod çalıştırmadan önce onay iste (1 = evet, 0 = hayır)
KOD_ONAYI=1
# Kod çalıştırmayı Docker içinde yap (1 = evet). Docker kurulu olmalı.
DOCKER_SANDBOX=0

# --- Video stüdyosu ---
# taslak = GPU'suz önizleme, comfyui = gerçek üretim (ComfyUI çalışıyor olmalı)
VIDEO_MOTORU=taslak
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_IS_AKISI=is_akislari/metinden_video.json
COMFYUI_GORSELDEN_IS_AKISI=is_akislari/gorselden_video.json
VIDEO_GENISLIK=1280
VIDEO_YUKSEKLIK=720
VIDEO_FPS=24
# Modelin tek seferde ürettiği en uzun klip; daha uzun sahneler otomatik zincirlenir
MOTOR_AZAMI_SURE=5
# YAZI_TIPI=C:/Windows/Fonts/arial.ttf
# Türkçe seslendirme (pip install piper-tts + ses modeli), bkz. asistan/studyo/ses.py
# PIPER_MODELI=modeller/tr_TR-dfki-medium.onnx
